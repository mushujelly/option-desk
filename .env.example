# Project-local configuration only. No midas files are read.
OD_DATABASE_URL=postgresql+psycopg://optiondesk:optiondesk@127.0.0.1:55432/optiondesk
OD_MODE=offline
OD_PORT=8765
OD_MAX_CONTRACTS=100
OD_REFRESH_SECONDS=60
# Enable named providers only after setting this project's own credentials.
OD_PROVIDERS=
OD_SCHWAB_APP_KEY=
OD_SCHWAB_APP_SECRET=
OD_SCHWAB_TOKEN_PATH=.state/schwab-token.json
OD_OPEND_HOST=127.0.0.1
OD_OPEND_PORT=11111
OD_POLYGON_API_KEY=
OD_POLYGON_BASE_URL=https://api.massive.com
# Live source ingestion must be explicitly authorized and enabled.
OD_SOURCE_INGESTION_ENABLED=false
OD_DISCORD_TOKEN=
OD_DISCORD_CHANNELS=
OD_MONGO_URI=
OD_MONGO_DB=wfreedom
OD_MONGO_COLLECTION=tweets
OD_MONGO_CHANNELS=

# Historical source backfill window; checkpoints persist in project DB.
OD_SOURCE_LOOKBACK_DAYS=30
